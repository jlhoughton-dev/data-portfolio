  create or replace view `jlhoughton-dev`.`chinook_raw`.`int_clinic_monthly_activity`
  OPTIONS()
  as with clinics as (
    select * from `jlhoughton-dev`.`vet_saas`.`dim_clinics`
),

billing as (
    select
        clinic_id,
        invoice_date,
        amount,
        status
    from `jlhoughton-dev`.`vet_saas`.`fct_billing`
),

scribe as (
    select
        clinic_id,
        event_date,
        scribe_sessions
    from `jlhoughton-dev`.`vet_saas`.`fct_scribe_events`
)

select
    c.clinic_id,
    c.clinic_name,
    c.tier,
    c.signup_date,
    c.mrr,
    b.invoice_date,
    b.amount as billing_amount,
    b.status as billing_status,
    s.event_date,
    s.scribe_sessions
from clinics c
left join billing b on c.clinic_id = b.clinic_id
left join scribe s on c.clinic_id = s.clinic_id;



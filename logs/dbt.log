  create or replace view `jlhoughton-dev`.`vet_saas`.`fct_clinic_monthly_performance`
  OPTIONS()
  as 

with raw_activity as (
    select * from `jlhoughton-dev`.`vet_saas`.`int_clinic_monthly_activity`
),

-- monthly agg for activity
monthly_aggregated as (
    select
        clinic_id,
        clinic_name,
        tier,
        signup_date,
        -- Group by first day of the month using COALESCE on available dates
        date_trunc(coalesce(invoice_date, event_date), month) as activity_month,
        
        -- Core Aggregations
        sum(coalesce(billing_amount, 0)) as total_billed,
        sum(coalesce(scribe_sessions, 0)) as total_scribe_events
        
    from raw_activity
    group by 1, 2, 3, 4, 5
),

calculated_metrics as (
    select
        clinic_id,
        activity_month,
        
        -- mrr and scribe event counts
        coalesce(total_billed, 0) as mrr,
        coalesce(total_scribe_events, 0) as total_scribe_events,
        
        -- engagement rankings based on scribe event counts
        case 
            when coalesce(total_scribe_events, 0) = 0 then 'Zero Activity'
            when coalesce(total_scribe_events, 0) < 10 then 'Low Usage'
            when coalesce(total_scribe_events, 0) between 10 and 50 then 'Moderate Usage'
            else 'Power User'
        end as engagement_tier,

        -- account as active if there is any billing or scribe activity in the month
        case 
            when coalesce(total_billed, 0) > 0 or coalesce(total_scribe_events, 0) > 0 then true 
            else false 
        end as is_active,

        -- MoM compare
        lag(total_billed) over (
            partition by clinic_id 
            order by activity_month
        ) as prev_month_mrr,

        lag(total_scribe_events) over (
            partition by clinic_id 
            order by activity_month
        ) as prev_month_scribe_events

    from monthly_activity
)

select
    *,
    -- Rev variance
    mrr - coalesce(prev_month_mrr, 0) as mrr_change,
    
    -- risk status based on churn
    case 
        when prev_month_mrr > 0 and mrr = 0 then 'Churned'
        when prev_month_mrr > 0 and mrr < prev_month_mrr then 'At Risk (Contract Downgrade)'
        when prev_month_mrr = 0 or prev_month_mrr is null then 'New / Reactivated'
        else 'Stable / Growing'
    end as clinic_health_status

from calculated_metrics;


